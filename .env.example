# AT Field CI Configuration
# Copy this to .env and customize

PORT=3000

# Bootstrap admin (only used when DB has zero users)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Legacy aliases (still accepted for bootstrap)
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me-to-a-strong-password

# SQLite path (default: ./data/at-field-ci.db)
# DB_PATH=/app/data/at-field-ci.db

# Set to 1 when behind HTTPS reverse proxy (Secure cookies)
# COOKIE_SECURE=1

# Commit poll interval for repos with "Poll for commits" enabled (ms, min 15000)
# POLL_INTERVAL_MS=60000

NODE_ENV=production
